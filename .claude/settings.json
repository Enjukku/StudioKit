{
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/subagent_context.py"], "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/compact_context.py"], "timeout": 10 }
        ]
      }
    ]
  }
}
