  "sets": {
    "weekly": {
      "about": "Engagement, retention and monetization for the weekly read. 42 days so the last 4 weeks have a full prior week and late retention revisions are re-pulled.",
      "lookback_days": 42,
      "queries": [
        {"metric": "DailyActiveUsers", "granularity": "OneDay"},
        {"metric": "DailyActiveUsers", "granularity": "OneDay", "breakdown": ["IsNewUser"]},
        {"metric": "DailyActiveUsers", "granularity": "OneDay", "breakdown": ["Platform"]},
        {"metric": "DailyActiveUsers", "granularity": "OneWeek"},
        {"metric": "MonthlyActiveUsers", "granularity": "OneDay"},
        {"metric": "DauMauStickiness", "granularity": "OneDay"},
        {"metric": "ForwardD1Retention", "granularity": "OneDay"},
        {"metric": "ForwardD7Retention", "granularity": "OneDay"},
        {"metric": "ForwardD30Retention", "granularity": "OneDay"},
        {"metric": "AveragePlayTimeMinutesPerDAU", "granularity": "OneDay"},
        {"metric": "AverageSessionLengthMinutes", "granularity": "OneDay"},
        {"metric": "TotalPlayTimeHours", "granularity": "OneDay"},
        {"metric": "Visits", "granularity": "OneDay"},
        {"metric": "DailyRevenue", "granularity": "OneDay"},
        {"metric": "PayingUsers", "granularity": "OneDay"},
        {"metric": "PayingUsersCVR", "granularity": "OneDay"},
        {"metric": "AverageRevenuePerUser", "granularity": "OneDay"},
        {"metric": "AverageRevenuePerPayingUser", "granularity": "OneDay"}
      ]
    },
    "performance": {
      "about": "Stability and speed. Roblox keeps these 28 days only: this tool's history is the only long record. Pull at least every 21 days.",
      "lookback_days": 26,
      "queries": [
        {"metric": "ClientCrashRate15m", "granularity": "OneDay"},
        {"metric": "ClientCrashRate15m", "granularity": "OneDay", "breakdown": ["Platform"]},
        {"metric": "ClientCrashCount", "granularity": "OneDay"},
        {"metric": "OomUnexpectedExits", "granularity": "OneDay"},
        {"metric": "ServerCrashCount", "granularity": "OneDay"},
        {"metric": "PeakConcurrentPlayers", "granularity": "OneDay"},
        {"metric": "ClientFpsP10", "granularity": "OneDay"},
        {"metric": "ClientFpsP10", "granularity": "OneDay", "breakdown": ["Platform"]},
        {"metric": "ClientFpsP50", "granularity": "OneDay"},
        {"metric": "ClientMemoryUsageP90", "granularity": "OneDay"},
        {"metric": "ServerFrameRateP10", "granularity": "OneDay"},
        {"metric": "ServerFrameRateP50", "granularity": "OneDay"},
        {"metric": "MemoryUsageP90", "granularity": "OneDay"},
        {"metric": "SessionDurationSecondsP50", "granularity": "OneDay"}
      ]
    },
    "funnel": {
      "about": "Two-step funnel read (docs 'Funnel steps'): discover step ids over 90 days, then per-step user metrics over the last 28 days filtered to those steps. Needs --funnel NAME (the game's funnel name).",
      "discovery": {"metric": "FunnelUserTotalCount", "granularity": "None", "breakdown": ["FunnelStep"], "lookback_days": 90},
      "lookback_days": 28,
      "queries": [
        {"metric": "FunnelUserTotalCount", "granularity": "None", "breakdown": ["FunnelStep"]},
        {"metric": "FunnelUserStepCompletionRate", "granularity": "None", "breakdown": ["FunnelStep"]},
        {"metric": "FunnelUserOverallCompletionRate", "granularity": "None", "breakdown": ["FunnelStep"]},
        {"metric": "FunnelUserChurnRate", "granularity": "None", "breakdown": ["FunnelStep"]}
      ]
    }
  }
