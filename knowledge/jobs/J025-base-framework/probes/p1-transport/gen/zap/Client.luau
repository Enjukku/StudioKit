local function SendEvents()
	if outgoing_used ~= 0 then
		local buff = buffer.create(outgoing_used)
		buffer.copy(buff, 0, outgoing_buff, 0, outgoing_used)

		reliable:FireServer(buff, outgoing_inst)

		outgoing_buff = buffer.create(64)
		outgoing_used = 0
		outgoing_size = 64
		table.clear(outgoing_inst)
	end
end

RunService.Heartbeat:Connect(SendEvents)

local reliable_events = table.create(1)
local reliable_event_queue: { [number]: { any } } = table.create(1)
reliable_event_queue[0] = {}
reliable.OnClientEvent:Connect(function(buff, inst)
	incoming_buff = buff
	incoming_inst = inst
	incoming_read = 0
	incoming_ipos = 0
	local len = buffer.len(buff)
	while incoming_read < len do
		local id = buffer.readu8(buff, read(1))
		if id == 0 then -- DamState
			local value
			local bool_1 = buffer.readu8(incoming_buff, read(1))
			value = {  }
			value["Seq"] = buffer.readu32(incoming_buff, read(4))
			if bit32.btest(bool_1, 0b0000000000000001) then
				value["Phase"] = "Building"
			elseif bit32.btest(bool_1, 0b0000000000000010) then
				value["Phase"] = "Won"
			elseif bit32.btest(bool_1, 0b0000000000000100) then
				value["Phase"] = "Flooded"
			end
			value["Quota"] = buffer.readu16(incoming_buff, read(2))
			value["Placed"] = buffer.readu16(incoming_buff, read(2))
			value["GymMultiplier"] = buffer.readf32(incoming_buff, read(4))
			assert(value["GymMultiplier"] >= 0, "value is less than 0!")
			assert(value["GymMultiplier"] <= 100, "value is more than 100!")
			value["EndsAt"] = buffer.readf64(incoming_buff, read(8))
			value["Cells"] = {  }
			if not bit32.btest(bool_1, 0b0000000000001000) then
				for _ = 1, buffer.readu16(incoming_buff, read(2)) + 1 do
					local key_1
					local val_1
					key_1 = buffer.readu16(incoming_buff, read(2))
					val_1 = {  }
					local len_1 = buffer.readu8(incoming_buff, read(1))
					assert(len_1 <= 80, "value is more than 80!")
					val_1["Owner"] = buffer.readstring(incoming_buff, read(len_1), len_1)
					assert(utf8.len(val_1["Owner"]) ~= nil, "value is not valid utf-8")
					val_1["Hp"] = buffer.readu8(incoming_buff, read(1))
					assert(val_1["Hp"] >= 0, "value is less than 0!")
					assert(val_1["Hp"] <= 100, "value is more than 100!")
					value["Cells"][key_1] = val_1
				end
			end
			local len_2 = buffer.readu8(incoming_buff, read(1))
			assert(len_2 <= 8, "value is more than 8!")
			value["Labels"] = table.create(len_2)
			for i_1 = 1, len_2 do
				local val_2
				local len_3 = buffer.readu8(incoming_buff, read(1))
				assert(len_3 <= 128, "value is more than 128!")
				val_2 = buffer.readstring(incoming_buff, read(len_3), len_3)
				assert(utf8.len(val_2) ~= nil, "value is not valid utf-8")
				value["Labels"][i_1] = val_2
			end
			if reliable_events[0] then
				task.spawn(reliable_events[0], value)
			else
				table.insert(reliable_event_queue[0], value)
				if #reliable_event_queue[0] > 64 then
					warn(`[ZAP] {#reliable_event_queue[0]} events in queue for DamState. Did you forget to attach a listener?`)
				end
			end
		else
			error("Unknown event id")
		end
	end
end)
table.freeze(polling_queues_reliable)
table.freeze(polling_queues_unreliable)

